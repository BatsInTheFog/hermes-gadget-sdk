# Waveshare ESP32-S3-Touch-AMOLED-1.8 (V1, SH8601 + FT3168): ESP32-S3R8 (8 MB
# octal PSRAM), 16 MB flash, rectangular 368x448 SH8601 AMOLED, FT3168 touch,
# ES8311 codec with an analog electret microphone, AXP2101 PMIC and a TCA9554
# I/O expander driving the display/touch resets.
# Pins: docs/hardware.md#esp32-s3-touch-amoled-18-v1
CONFIG_IDF_TARGET="esp32s3"
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# The USB-C port is the S3's own USB Serial/JTAG; the console must live on USB.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_HG_BOARD_AMOLED_18_V1=y
# This board's own 16 MB table: two 6 MB app slots and an assets partition
# (boards/esp32s3-touch-amoled-18-v1/partitions.csv). Changing tables needs a USB flash.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/esp32s3-touch-amoled-18-v1/partitions.csv"

# Wisp's face streams through PSRAM (composed on one core, sent from the other): 64-byte cache
# lines fetch twice as much per miss, at no extra internal RAM. Run-time stats let `diag`
# show each task's share of the CPU ("cpu").
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# TCP windows for links with a long round trip (a phone hotspot): 5,760 B capped
# a connection near 33 KB/s at 175 ms, below 24 kHz audio's 48 KB/s.
# Wi-Fi and lwIP buffers in PSRAM first, internal RAM when the module has none.
# docs/porting.md#network-buffers
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Always ask the router for an address with a full DHCP discovery. Asking straight for
# the last address (the base default) left this board without an address for minutes on
# a Google mesh network that ignores a request for an address it didn't expect.
# CONFIG_LWIP_DHCP_RESTORE_LAST_IP is not set

# Tailnet (docs/hardware-validation.md#tailnet): Wisp joins Tailscale itself to reach Hermes
# from any network.
CONFIG_HG_TAILNET=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_RCVBUF=y
# Internal RAM: the relay's always-open TLS buffers in PSRAM.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
